---
// src/layouts/AppLayout.astro
import SideBar from '../components/SideBar.astro';
import SearchBar from '../components/SearchBar.astro';
import CardDetailModal from '../components/CardDetailModal.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/modal.css';

// 【站点主导航】依据当前路径高亮「导航 / 资源」板块 Tab
const pathname = Astro.url.pathname;
const isNavActive = pathname === '/' || pathname === '/index.html';
const isResourceActive = pathname.startsWith('/resource');

// 页面标题 / 右下角视图切换按钮 / 侧边栏 均可被子页面覆盖
// （资源页 hideSidebar=true：隐藏侧边栏与折叠按钮，主内容占满整宽）
const { title = 'LocateMC', showViewToggle = true, hideSidebar = false } = Astro.props;

// 移动端下拉菜单是否需要搜索栏：仅当页面提供了 header-search 插槽（如导航页）
const hasHeaderSearch = Astro.slots.has('header-search');
// 移动端下拉菜单（☰ → 搜索栏 + 分类导航栏）是否需要渲染：
// 资源页无搜索栏且无分类导航，只需底部固定「导航 / 资源」切换，无需 ☰ 菜单
const needsMobileMenu = hasHeaderSearch || !hideSidebar;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/LocateMC_icon.png" />
  <title>{title}</title>
  <!-- 页面切换平滑过渡（View Transitions），无刷新动画切换「导航 / 资源」 -->
  <ViewTransitions />
</head>
<body>
  <div class:list={['app-container', { 'no-sidebar': hideSidebar }]}>
    {!hideSidebar && (
      <aside id="sidebar" class="sidebar">
        <SideBar />
      </aside>
    )}

    <div class="main-content-wrapper">
      <header class="page-header">
        <!-- 【核心修改 1】将 Logo 与折叠按钮包裹在 header-left 中保持邻近 -->
        <div class="header-left">
          <h1 class="logo">LocateMC</h1>

          {!hideSidebar && (
            <button id="sidebar-toggle" class="sidebar-toggle" aria-label="Toggle sidebar">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          )}
        </div>

        <!-- 【站点主导航】「导航 / 资源」板块 Tab（桌面版：相对页眉水平居中略偏左）；移动端隐藏、收纳进下方下拉菜单 -->
        <nav class="site-tabs site-tabs--header" aria-label="站点主导航">
          <a href="/" class:list={['site-tab', { active: isNavActive }]}>导航</a>
          <a href="/resource" class:list={['site-tab', 'site-tab--resource', { active: isResourceActive }]}>资源</a>
        </nav>
        <!-- 【搜索栏插槽】搜索栏由页面传入，桌面位于页眉右侧；移动端隐藏、收纳进下方下拉菜单 -->
        <div class="header-search-slot"><slot name="header-search" /></div>

        <!-- 【移动端菜单按钮】仅窄屏且页面含菜单内容时出现，位于页眉右上角；展开 / 收起下拉菜单 -->
        {needsMobileMenu && (
          <button
            id="mobile-menu-toggle"
            class="mobile-menu-toggle"
            type="button"
            aria-label="打开菜单"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            <svg class="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
        )}
      </header>

      <!-- 【移动端下拉菜单】窄屏点击 ☰ 展开，自上而下依次为：
           ① 搜索栏  ② 分类导航栏（SideBar）；
           「导航 / 资源」板块切换已独立为页面底部固定条（mobile-bottom-tabs）；
           桌面宽度下本面板隐藏，不参与布局。 -->
      {needsMobileMenu && (
        <>
          <div id="mobile-menu-backdrop" class="mobile-menu-backdrop"></div>
          <div id="mobile-menu" class="mobile-menu" aria-label="移动端菜单">
            <div class="mobile-menu-inner">
              {hasHeaderSearch && (
                <div class="mobile-search">
                  <SearchBar uid="m" />
                </div>
              )}

              {!hideSidebar && (
                <div class="mobile-nav">
                  <SideBar />
                </div>
              )}
            </div>
          </div>
        </>
      )}

      <main class="page-main">
        <slot />
      </main>
    </div>
  </div>

  <!-- 【移动端底部固定条】仅窄屏显示：把「导航 / 资源」板块切换固定在页面底部 -->
  <nav id="mobile-bottom-tabs" class="mobile-bottom-tabs" aria-label="站点主导航">
    <a href="/" class:list={['mbt-item', { active: isNavActive }]}>导航</a>
    <a href="/resource" class:list={['mbt-item', { active: isResourceActive }]}>资源</a>
  </nav>

  <CardDetailModal />

  <!-- 视图模式切换按钮（页面右下角浮动）：在「分组堆叠」与「子分类 Tab」之间切换；仅导航页需要 -->
  {showViewToggle && (
    <button
      id="viewModeToggle"
      class="view-mode-toggle"
      type="button"
      aria-label="切换显示模式"
      data-view="stacked"
    >
      <span class="vmt-icon" aria-hidden="true">▤</span>
      <span class="vmt-label">Tab 视图</span>
    </button>
  )}

  <style is:global>
    @font-face {
      font-family: 'HarmonyOS Sans'; 
      src: url('/fonts/HarmonyOS_Sans_SC_Regular.woff') format('woff');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'HarmonyOS Sans';
      src: url('/fonts/HarmonyOS_Sans_SC_Bold.woff') format('woff');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    body {
      margin: 0;
      font-family: 'HarmonyOS Sans', sans-serif;
      background-color: #ffffff;
    }

    /* ===== 页面切换平滑过渡（View Transitions）=====
       旧页轻微下移淡出，新页轻微上移淡入；尊重系统减弱动效设置 */
    @media (prefers-reduced-motion: no-preference) {
      ::view-transition-old(root) {
        animation: lm-view-out 0.16s ease both;
      }
      ::view-transition-new(root) {
        animation: lm-view-in 0.26s ease both;
      }
    }
    @keyframes lm-view-out {
      to { opacity: 0; transform: translateY(5px); }
    }
    @keyframes lm-view-in {
      from { opacity: 0; transform: translateY(-5px); }
    }

    /* ===== 页眉在页面过渡中保持不动 =====
       给页眉独立的 view-transition 层并禁用其动画：切换时 header
       （Logo / 板块 Tab / 搜索栏）原位静止，只有下方内容区做淡入淡出位移。 */
    .page-header {
      view-transition-name: page-header;
    }
    ::view-transition-old(page-header),
    ::view-transition-new(page-header) {
      animation: none;
      mix-blend-mode: normal;
    }
  </style>

  <style>
    .app-container { 
      display: flex; 
    }
    .sidebar { 
      width: 220px; 
      height: 100vh; 
      position: sticky; 
      top: 0; 
      background-color: #f7f7f8; 
      border-right: 1px solid #e5e5e5; 
      flex-shrink: 0;
      transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding-top: 80px; /* 为固定的页眉留出空间 */
      box-sizing: border-box; /* 确保 padding 不会增加高度 */
      /* 【修复】侧边栏独立滚动：全部子分类展开后内容会超过视口高度，
         不加 overflow 会导致底部被截断且无法滚动到达。与右侧滚动区互不影响。 */
      overflow-y: auto;
      scrollbar-width: thin; /* Firefox 细滚动条 */
      scrollbar-color: #d8d8da transparent;
    }
    .sidebar::-webkit-scrollbar { width: 6px; }
    .sidebar::-webkit-scrollbar-thumb { background: #d8d8da; border-radius: 3px; }
    .sidebar::-webkit-scrollbar-thumb:hover { background: #b9b9bd; }
    .sidebar::-webkit-scrollbar-track { background: transparent; }
    .main-content-wrapper { 
      flex-grow: 1; 
      width: calc(100vw - 220px);
      height: 100vh;
      overflow-y: auto;
      /* 【优化】导航锚点平滑滚动：点击侧边栏分类时右侧内容区平滑滚到对应区块 */
      scroll-behavior: smooth;
      transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* 无侧边栏页面（如资源页）：主内容区不再扣除 220px，占满整宽 */
    .app-container.no-sidebar .main-content-wrapper {
      width: 100vw;
    }
    
    .sidebar.collapsed {
      margin-left: -220px;
    }
    
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 80px;
      padding: 0 2rem;
      position: fixed; /* 关键：始终固定在视口顶部 */
      top: 0;
      left: 0; /* 从左侧开始 */
      width: 100%; /* 占满整个宽度 */
      box-sizing: border-box; /* 确保 padding 不会增加宽度 */
      background-color: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid #e5e5e5;
      z-index: 200;
    }
    
    /* 【核心修改 2】新增 header-left 样式，用于包裹 Logo 和按钮 */
    .header-left {
      display: flex;
      align-items: center;
      gap: 1.5rem; /* Logo 和按钮之间的间距 */
    }
    .logo {
      font-size: 1.8rem;
      font-weight: 700;
      color: #111;
      margin: 0;
    }
    .sidebar-toggle {
      background: none; 
      border: 1px solid #ddd; 
      border-radius: 50%;
      width: 32px; height: 32px; 
      flex-shrink: 0; 
      cursor: pointer;
      display: flex; 
      justify-content: center; 
      align-items: center;
      color: #666; 
      transition: transform 0.3s ease, background-color 0.2s;
    }
    .sidebar-toggle:hover {
      background-color: #f0f0f0;
    }

    /* 【站点主导航 Tab】「导航 / 资源」板块切换：无底色，仅文字 hover / 当前页变蓝 */
    .site-tabs {
      display: flex;
      gap: 2rem;
      flex-shrink: 0;
      z-index: 1;
      white-space: nowrap;
    }
    /* 页眉内实例：绝对定位相对页眉水平居中略偏左（仅桌面 >768px 生效） */
    .site-tabs--header {
      position: absolute;
      left: 26.5%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .site-tab {
      padding: 2px 0;
      font-size: 1.15rem;
      font-weight: 500;
      color: #444;
      text-decoration: none;
      white-space: nowrap;
      transition: color 0.15s ease;
    }
    .site-tab:hover { color: #3b82f6; }
    .site-tab.active {
      color: #1d4ed8;
      font-weight: 600;
    }
    /* 仅「资源」相对「导航」单独往右错开（组整体位置不动） */
    .site-tab--resource {
      margin-left: 1.5rem;
    }
    /* 中窄屏（769~900px 平板）：解除绝对定位回到文档流，并适度缩小字体避免挤压搜索栏 */
    @media (max-width: 900px) {
      .site-tabs--header { position: static; transform: none; }
      .site-tab { font-size: 1rem; }
      .header-left { gap: 0.75rem; }
    }
    /* 页眉搜索栏容器：占据页眉剩余空间并右对齐（slot 内容在内部靠右） */
    .header-search-slot {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      flex: 1 1 auto;
      min-width: 0;
      margin-left: auto;
    }

    /* ===== 移动端菜单按钮（☰ / ✕）：默认隐藏，仅 ≤768px 显示在页眉右上角 ===== */
    .mobile-menu-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      margin-left: auto;
      flex-shrink: 0;
      background: #ffffff;
      border: 1px solid #e3e3e3;
      border-radius: 50%;
      color: #333;
      cursor: pointer;
      padding: 0;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    .mobile-menu-toggle:hover { background-color: #f0f0f0; }
    .menu-icon-close { display: none; }

    /* ===== 移动端下拉菜单（遮罩 + 面板）：默认隐藏 ===== */
    .mobile-menu-backdrop,
    .mobile-menu { display: none; }

    /* 下拉面板内部版式（自上而下：搜索栏 → 分类导航栏） */
    .mobile-menu-inner {
      padding: 0.6rem 1rem 1rem;
    }
    .mobile-search {
      padding: 0.4rem 0 0.8rem;
      border-bottom: 1px solid #f0f0f1;
    }
    .mobile-nav {
      padding-top: 0.6rem;
    }

    /* ===== 移动端底部固定条（导航 / 资源）：默认隐藏，仅 ≤768px 显示 ===== */
    .mobile-bottom-tabs {
      display: none;
    }

    /* 菜单展开态（body.mobile-menu-open 由脚本切换）：
       面板自页眉下缘下拉，覆盖主内容区；遮罩可点击关闭 */
    body.mobile-menu-open .mobile-menu-backdrop {
      display: block;
      position: fixed;
      top: 56px;
      right: 0;
      bottom: 0;
      left: 0;
      background: rgba(15, 20, 30, 0.35);
      z-index: 204;
    }
    body.mobile-menu-open .mobile-menu {
      display: block;
      position: fixed;
      top: 56px;
      left: 0;
      right: 0;
      max-height: calc(100vh - 56px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      background: #ffffff;
      border-bottom: 1px solid #e5e5e5;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
      z-index: 205;
      animation: mobile-menu-in 0.18s ease;
    }
    body.mobile-menu-open .mobile-menu-toggle .menu-icon-open { display: none; }
    body.mobile-menu-open .mobile-menu-toggle .menu-icon-close { display: block; }
    @keyframes mobile-menu-in {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: none; }
    }
    
    /* 
      【核心修改 3】
      确保旋转效果被正确应用。
      :global() 不是必需的，因为这个按钮和 sidebar 都在同一个组件的作用域内。
    */
    .sidebar.collapsed + .main-content-wrapper .sidebar-toggle {
      transform: rotate(180deg);
    }
    
    .page-main {
      padding: 2rem 3rem;
      margin-top: 80px; /* 关键：为固定的页眉留出空间 */
    }

    /* ===== 视图模式切换按钮（页面右下角浮动）===== */
    .view-mode-toggle {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 150;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.1rem;
      background: #ffffff;
      border: 1px solid #e5e5e5;
      border-radius: 999px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
      font-size: 0.9rem;
      color: #333;
      cursor: pointer;
      transition: transform 0.15s ease,
                  box-shadow 0.2s ease,
                  background-color 0.2s ease;
      font-family: inherit;
    }
    .view-mode-toggle:hover {
      background-color: #f7f7f8;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
      transform: translateY(-1px);
    }
    .view-mode-toggle:active { transform: translateY(0); }
    .view-mode-toggle .vmt-icon { font-size: 1.05rem; line-height: 1; }

    /* ===== 移动端（≤768px）整体布局 =====
       置于样式末尾：确保覆盖上方同优先级的默认布局规则 */
    @media (max-width: 768px) {
      /* 主容器恢复单列；页眉固定高度收窄为 56px */
      .app-container { display: block; }
      /* 桌面左侧固定栏隐藏：分类导航改由下拉菜单中的 SideBar 实例提供 */
      .sidebar { display: none; }
      .main-content-wrapper { width: 100vw; }

      .page-header {
        height: 56px;
        padding: 0 1rem;
      }
      .header-left { gap: 0.5rem; }
      .logo { font-size: 1.4rem; }
      #sidebar-toggle { display: none; }
      /* 页眉只保留 Logo +（有菜单内容时）右上角菜单按钮 */
      .site-tabs--header { display: none; }
      .header-search-slot { display: none; }
      .mobile-menu-toggle { display: flex; }

      .page-main {
        padding: 1.25rem 1rem 2.5rem;
        margin-top: 56px;
        /* 主内容底部让出安全区，避免被底部固定条遮挡 */
        padding-bottom: calc(2.5rem + 70px);
      }
      /* 菜单展开时锁住主内容区滚动（面板自身滚动） */
      body.mobile-menu-open .main-content-wrapper { overflow: hidden; }

      /* 底部固定「导航 / 资源」切换条 */
      .mobile-bottom-tabs {
        display: flex;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: calc(54px + env(safe-area-inset-bottom, 0px));
        padding-bottom: env(safe-area-inset-bottom, 0px);
        box-sizing: border-box;
        z-index: 160;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        border-top: 1px solid #e5e5e5;
      }
      .mbt-item {
        flex: 1 1 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.02rem;
        font-weight: 500;
        color: #666;
        text-decoration: none;
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .mbt-item:hover { background-color: rgba(0, 0, 0, 0.03); }
      .mbt-item.active {
        color: #1d4ed8;
        font-weight: 600;
        background-color: rgba(29, 78, 216, 0.06);
      }
      /* 右下角「视图模式切换」按钮上移，避免与底部条重叠 */
      .view-mode-toggle {
        bottom: 72px;
        z-index: 170;
      }
    }
  </style>

  <!--
    Tab 视图相关样式必须全局生效：
    作用于 index.astro 渲染的 .subcategory-block / .subcategory-tabs 元素，
    若放在 scoped <style> 中会被 Astro 加 hash 属性导致选择器失配。
  -->
  <style is:global>
    body[data-view-mode="tab"] .subcategory-title { display: none; }
    body[data-view-mode="tab"] .subcategory-block:not([data-active="true"]) { display: none; }
    body[data-view-mode="tab"] .subcategory-block[data-active="true"] { margin-bottom: 1rem; }
    .subcategory-tabs {
      display: flex;
      gap: 4px;
      overflow-x: auto;
      margin-bottom: 1.25rem;
      padding: 6px;
      background: #f5f6f8;
      border: 1px solid #ececef;
      border-radius: 12px;
      scrollbar-width: thin;
      /* 宽度贴合内容；页面过窄时不超过容器宽度并可横向滚动 */
      width: fit-content;
      max-width: 100%;
      box-sizing: border-box;
    }
    .subcategory-tabs[hidden] { display: none; }
    .subcategory-tabs::-webkit-scrollbar { height: 6px; }
    .subcategory-tabs::-webkit-scrollbar-thumb { background: #d8d8da; border-radius: 3px; }
    .subcategory-tab {
      flex-shrink: 0;
      padding: 8px 14px;
      background: transparent;
      border: 0;
      border-radius: 8px;
      font-size: 0.92rem;
      color: #555;
      cursor: pointer;
      white-space: nowrap;
      transition: background-color 0.15s ease, color 0.15s ease;
      font-family: inherit;
    }
    .subcategory-tab:hover { background: rgba(0, 0, 0, 0.04); color: #222; }
    .subcategory-tab.active {
      background: #ffffff;
      color: #1d4ed8;
      font-weight: 600;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    }
    /* 搜索期间：无命中子分类的 tab 置灰（disabled 原生阻止 click） */
    .subcategory-tab:disabled { opacity: 0.45; cursor: not-allowed; }
    .subcategory-tab:disabled:hover { background: transparent; color: #555; }
    /*
      ===== 搜索过滤 class（index.astro 搜索脚本用，须全局生效）=====
      搜索过滤一律通过本 class 控制显隐，禁止写内联 display，
      否则会覆盖上方 body[data-view-mode="tab"] 的折叠规则导致 Tab 视图失效。
      !important 用于压过其它任何显示规则（如 tab 折叠 / 激活块样式）。
    */
    .search-hidden { display: none !important; }
  </style>

  <script>
    // View Transitions：页面每次切换后 DOM 均为新实例，故侧边栏 / 滚动 / 视图模式等
    // 交互需在每次导航后重建绑定 —— 统一由 astro:page-load（初次加载 + 每次导航触发）驱动。
    function initAppLayout() {
    const toggleButton = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('sidebar');

    if (toggleButton && sidebar) {
      toggleButton.addEventListener('click', () => {
        sidebar.classList.toggle('collapsed');
      });
    }

    // ===== 移动端下拉菜单（≤768px）：☰ 展开 / 收起 =====
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const menuBackdrop = document.getElementById('mobile-menu-backdrop');

    function setMobileMenu(open: boolean) {
      document.body.classList.toggle('mobile-menu-open', open);
      menuToggle?.setAttribute('aria-expanded', String(open));
    }

    // 每次页面加载 / 客户端导航后，菜单复位为收起状态
    setMobileMenu(false);

    if (menuToggle) {
      menuToggle.addEventListener('click', () => {
        setMobileMenu(!document.body.classList.contains('mobile-menu-open'));
      });
    }
    if (menuBackdrop) {
      // 点击半透明遮罩关闭菜单
      menuBackdrop.addEventListener('click', () => setMobileMenu(false));
    }

    // 菜单内点击任意链接（分类锚点 / 板块）后收起菜单；
    // 点击搜索按钮同样收起（执行搜索后让主内容区呈现过滤结果，见 2-2）
    const mobileMenu = document.getElementById('mobile-menu');
    mobileMenu?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a') || target.closest('.search-button')) setMobileMenu(false);
      // 点搜索按钮：过滤已应用，把主内容滚动回顶部，让结果显示在视野内
      if (target.closest('.search-button')) {
        document
          .querySelector('.main-content-wrapper')
          ?.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    // 【优化】导航点击增强：点击分类时自动展开对应子菜单 + 滚动过程高亮当前分类
    const mainContent = document.querySelector('.main-content-wrapper');
    const navLinks = document.querySelectorAll('.sidebar-nav a[href^="#"]');

    if (mainContent && navLinks.length) {
      // 1) 点击导航链接：若所属子菜单未展开则展开（与内容区滚动到分类的动作同步）
      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          const details = link.closest('details');
          if (details && !details.open) details.open = true;
        });
      });

      // 2) scrollspy：监听右侧滚动容器，高亮当前所在的分类
      const sections = document.querySelectorAll('.category-section');
      const spy = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navLinks.forEach(a => {
              a.classList.toggle('active', a.getAttribute('href') === '#' + id);
            });
          }
        });
      }, { root: mainContent, rootMargin: '-15% 0px -75% 0px', threshold: 0 });
      sections.forEach(sec => spy.observe(sec));

      // 3) Tab 视图下点击侧边栏子分类链接：先激活对应子分类 Tab，再平滑滚动到主分类大标题。
      //    —— tab 模式中未激活的子分类区块为 display:none，原生锚点滚动无法定位到隐藏元素；
      //    这里复用 tab 按钮的点击逻辑（同步 data-active 与按钮高亮），随后手动滚动，
      //    使「点击左侧导航也能切换 Tab」成立。
      navLinks.forEach(link => {
        const targetId = link.getAttribute('href')?.slice(1);
        if (!targetId) return;
        const block = document.getElementById(targetId);
        // 仅处理指向子分类区块的链接；主分类链接指向的 section 在 tab 模式下始终可见，走原生锚点即可
        if (!block || !block.classList.contains('subcategory-block')) return;

        link.addEventListener('click', (event) => {
          if (document.body.dataset.viewMode !== 'tab') return; // stacked 模式无需干预

          const tabsBar = [...document.querySelectorAll('.subcategory-tabs')]
            .find(bar => bar.dataset.tabsFor === block.dataset.category);
          const tabBtn = tabsBar?.querySelector(`.subcategory-tab[data-target="${CSS.escape(block.dataset.subcategory)}"]`);
          // 无对应 tab，或搜索期间该子分类无命中（tab 被置灰）时，不做特殊处理
          if (!tabBtn || tabBtn.disabled) return;

          event.preventDefault();
          tabBtn.click(); // 切换 data-active 与按钮高亮，区块随即变为可见

          // 滚动目标：所属主分类的大标题（h2），其下方的 tab 栏与激活内容顺势进入视野；
          // 无标题时回退到 section 本身。偏移量取固定页眉实际高度（桌面 80 / 移动 56）。
          const section = block.closest('.category-section');
          const anchor = section?.querySelector('.category-title') || section || block;
          const headerEl = document.querySelector('.page-header');
          const headerH = headerEl ? headerEl.getBoundingClientRect().height : 80;
          const containerRect = mainContent.getBoundingClientRect();
          const targetTop = anchor.getBoundingClientRect().top - containerRect.top + mainContent.scrollTop - headerH;
          mainContent.scrollTo({ top: targetTop, behavior: 'smooth' });
        });
      });
    }

    // ===== 视图模式切换：「分组堆叠」↔「子分类 Tab」 =====
    const VIEW_MODE_KEY = 'locatemc-view-mode';
    const viewToggle = document.getElementById('viewModeToggle');
    const viewToggleLabel = viewToggle?.querySelector('.vmt-label');

    /**
     * 根据传入的子分类块列表构建 tab 按钮；首次构建后标记 built='true' 避免重复。
     */
    function buildTabsForCategory(container) {
      if (container.dataset.built === 'true') return;
      const cat = container.dataset.tabsFor;
      container.innerHTML = '';
      const blocks = document.querySelectorAll(`.subcategory-block[data-category="${cat}"]`);
      blocks.forEach(block => {
        const name = block.dataset.subcategory;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'subcategory-tab';
        btn.textContent = name;
        btn.dataset.target = name;
        if (block.dataset.active === 'true') btn.classList.add('active');
        btn.addEventListener('click', () => {
          blocks.forEach(b => {
            b.dataset.active = (b.dataset.subcategory === name) ? 'true' : 'false';
          });
          container.querySelectorAll('.subcategory-tab').forEach(t =>
            t.classList.toggle('active', t.dataset.target === name)
          );
        });
        container.appendChild(btn);
      });
      container.dataset.built = 'true';
    }

    function applyViewMode(mode) {
      document.body.dataset.viewMode = mode;
      if (viewToggle) viewToggle.dataset.view = mode;
      if (viewToggleLabel) viewToggleLabel.textContent = mode === 'tab' ? '分组视图' : 'Tab 视图';
      document.querySelectorAll('[data-tabs-for]').forEach(el => {
        if (mode === 'tab') {
          buildTabsForCategory(el);
          el.hidden = false;
        } else {
          el.hidden = true;
        }
      });
      // 通知页面：视图模式已切换（供 index.astro 重放当前搜索过滤）
      window.dispatchEvent(new CustomEvent('view-mode-changed', { detail: { mode } }));
    }

    applyViewMode(localStorage.getItem(VIEW_MODE_KEY) || 'stacked');

    if (viewToggle) {
      viewToggle.addEventListener('click', () => {
        const next = document.body.dataset.viewMode === 'tab' ? 'stacked' : 'tab';
        localStorage.setItem(VIEW_MODE_KEY, next);
        applyViewMode(next);
      });
    }

    // ===== 同步 sidebar 折叠状态到 body（供样式选择器使用） =====
    if (sidebar) {
      const syncCollapsed = () => {
        document.body.dataset.sidebarCollapsed =
          sidebar.classList.contains('collapsed') ? 'true' : 'false';
      };
      syncCollapsed();
      const observer = new MutationObserver(syncCollapsed);
      observer.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
    }

    // 全局收尾：Esc 关闭移动菜单；窗口回到桌面宽度时自动收起
    // （命名函数 + remove 后 add，避免 View Transitions 导航间重复累积监听）
    document.removeEventListener('keydown', onMenuKeydown);
    document.addEventListener('keydown', onMenuKeydown);
    const menuMq = window.matchMedia('(max-width: 768px)');
    menuMq.removeEventListener?.('change', onMenuMqChange);
    menuMq.addEventListener?.('change', onMenuMqChange);
    }

    // ===== 移动菜单辅助（模块级命名函数，供 removeEventListener 复用） =====
    function onMenuKeydown(e: KeyboardEvent) {
      if (e.key !== 'Escape') return;
      if (!document.body.classList.contains('mobile-menu-open')) return;
      document.body.classList.remove('mobile-menu-open');
      document.getElementById('mobile-menu-toggle')?.setAttribute('aria-expanded', 'false');
    }
    function onMenuMqChange(e: MediaQueryListEvent) {
      if (e.matches) return; // 仍处于移动宽度：保持现状
      document.body.classList.remove('mobile-menu-open');
      document.getElementById('mobile-menu-toggle')?.setAttribute('aria-expanded', 'false');
    }

    document.addEventListener('astro:page-load', initAppLayout);
  </script>
</body>
</html>