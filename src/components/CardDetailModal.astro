---
// src/components/CardDetailModal.astro
//
// 【性能修复 2026-09-14 — 页面切换卡顿根因】
// 原先这里是 <script define:vars={{ navData: serializableEntries }}>：
// define:vars 会强制把脚本内联，于是 268 条导航条目的「完整 Markdown 正文」
// 被序列化进每个渲染本组件的页面 HTML —— 实测 228,367 字符（≈450KB 字节）。
// 后果：
//   1) 线上首页 HTML ≈788KB、资源页 ≈500KB，其中资源页 95.2% 的 HTML
//      是它完全用不到的数据（资源页 nav-card 数为 0）；
//   2) View Transitions 每次客户端切换，都要重新解析并执行这 228K 脚本
//      （astro:before-preparation 阶段实测耗时 842ms），这就是
//      「首次加载后切换页面要停顿、还要多按几下」的直接原因。
//
// 现改为：脚本外置（可被打包）+ 首次真正需要时才 fetch /api/nav-detail.json，
// 并在页面空闲时提前预取；弹窗先显示「加载中」再填充，点击即时反馈。
---
<div id="modal-backdrop" class="modal-backdrop hidden">
  <div id="modal-panel" class="modal-panel">
    <button id="modal-close-btn" class="modal-close-btn" aria-label="关闭">×</button>
    <div id="modal-content" class="modal-content"></div>
  </div>
</div>

<script>
  // ════════════════════════════════════════════════════════════════════════
  // 【技术债/风险修复 2026-09-26】
  // 1) marked 由 jsdelivr CDN 改为本地依赖
  //    原实现加载 `https://cdn.jsdelivr.net/npm/marked/lib/marked.umd.js`：
  //      · 路径不带版本号 → 上游任意发布即时生效（供应链风险，且无 SRI 校验）
  //      · jsdelivr 在国内可达性差 → 加载失败直接退化成「详情加载失败」
  //      · 每次首开弹窗多一次跨域往返
  //    现改为 package.json 依赖（marked@18.0.14，--save-exact 锁定），随站点
  //    产物一起构建分发，运行时零第三方请求。
  // 2) 【重要 · 2026-09-26 二次修复】marked 改为**动态 import**
  //    顶层静态 `import { marked } from 'marked'` 会让本模块与 marked 强绑定：
  //    只要 marked 的依赖预构建/产物出任何问题，整个模块加载失败，连带下面的
  //    「事件委托」与「open-modal 监听」一起失效 —— 表现为点「详情」毫无反应、
  //    <a> 直接跳外站。此故障已真实发生：dev server 在 npm install marked
  //    **之前**启动，Vite 依赖图未重建，对 marked 的请求返回 504。
  //    改动态导入后：marked 成为独立 chunk（首访不再加载、点开弹窗才拉），
  //    加载失败只影响正文渲染，交互始终可用，且退化为纯文本展示。
  // 3) innerHTML 拼装补转义 + 危险标签剥离（见下方 esc / safeUrl / softenHtml）
  // ════════════════════════════════════════════════════════════════════════

  const DETAIL_URL = '/api/nav-detail.json';

  let detailPromise: Promise<any[] | null> | null = null; // 同一页面内只请求一次
  let markedPromise: Promise<any> | null = null;

  /**
   * 动态加载 marked（原因见文件头「二次修复」）。
   * 失败返回 null，由调用方走降级分支；不抛异常，确保不影响交互。
   */
  function getMarked(): Promise<any> {
    if (markedPromise) return markedPromise;
    markedPromise = import('marked')
      .then((m: any) => m.marked || m.default || m)
      .catch((err) => {
        console.error('[CardDetailModal] marked 加载失败，正文降级为纯文本：', err);
        markedPromise = null; // 允许下次点击重试
        return null;
      });
    return markedPromise;
  }

  /** HTML 实体转义：所有插入到 innerHTML 的「数据字段」都必须先过这里 */
  function esc(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string)
    );
  }

  /** 协议白名单：只放行 http/https/相对路径，挡掉 javascript: / data: 等 */
  function safeUrl(value: unknown): string {
    const s = String(value ?? '').trim();
    if (!s) return '#';
    if (/^(https?:)?\/\//i.test(s) || /^\/[^/]/.test(s)) return s;
    return '#';
  }

  /**
   * Markdown 渲染结果的「尽力而为」加固。
   * 说明：条目正文由本站维护（content/nav/*.md，经 admin 写入），并非用户输入，
   * 因此这里不做完整 sanitizer（不引入 DOMPurify 的体积）。仅剥离明确的高危构造，
   * 作为纵深防御——避免将来万一引入外部来源内容时直接变成 XSS。
   */
  function softenHtml(html: unknown): string {
    return String(html ?? '')
      .replace(/<\/?(script|iframe|object|embed|form|link|meta|base|style)\b[^>]*>/gi, '')
      .replace(/\son[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
      .replace(/(href|src)\s*=\s*(["']?)\s*javascript:[^"'>\s]*/gi, '$1=$2#');
  }

  /** 拉取全部条目详情（失败后可重试） */
  function loadDetails(): Promise<any[] | null> {
    if (!detailPromise) {
      detailPromise = fetch(DETAIL_URL)
        .then((r) => (r.ok ? r.json() : null))
        .catch((err) => {
          console.error('Failed to load nav details:', err);
          return null;
        })
        .then((list) => {
          if (!list) detailPromise = null; // 失败不缓存，下次点击可重试
          return list;
        });
    }
    return detailPromise;
  }

  /** 页面空闲时预取详情数据：用户真正点「详情」时通常已就绪，弹窗瞬开 */
  function prefetchDetails() {
    if (!document.getElementById('modal-backdrop')) return; // 本页无弹窗（如资源页）
    const run = () => { loadDetails(); };
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(run, { timeout: 4000 });
    } else {
      setTimeout(run, 1500);
    }
  }
  document.addEventListener('astro:page-load', prefetchDetails);

  // 「打开弹窗」由窗口级事件驱动（仅导航页卡片会派发）；
  // 弹窗元素每次导航都是新实例，故 handler 内实时查询当前文档 DOM。
  window.addEventListener('open-modal', async (event: any) => {
    const backdrop = document.getElementById('modal-backdrop');
    const contentEl = document.getElementById('modal-content');
    if (!backdrop || !contentEl) return;

    const { entryId } = event.detail || {};

    // 先出弹窗骨架 + 加载态：点击立刻有反馈，避免「以为没点到」而重复点击
    contentEl.innerHTML = '<div class="modal-loading">正在加载详情…</div>';
    backdrop.classList.remove('hidden');

    try {
      // marked 已随产物打包，无需再等待 CDN，只需等数据
      const list = await loadDetails();
      if (!list) {
        contentEl.innerHTML = '<div class="modal-loading">详情加载失败，请检查网络后重试。</div>';
        return;
      }
      const entry = list.find((e: any) => e.id === entryId);
      if (!entry) {
        contentEl.innerHTML = '<div class="modal-loading">未找到该条目的详情。</div>';
        return;
      }
      // marked v18：parse() 为同步方法（未启用 async 扩展时返回 string）。
      // 先过 softenHtml 剥离高危构造，再交给 innerHTML。
      // 若 marked 未能加载则降级为纯文本 —— 弹窗的核心信息（图标 / 标题 /
      // 描述 / 访问按钮）本来就不依赖 marked，始终完整可用。
      const md = await getMarked();
      const renderedHTML = md
        ? softenHtml(md.parse(entry.body ?? '') as string)
        : `<pre class="modal-body-fallback">${esc(entry.body ?? '')}</pre>`;

      contentEl.innerHTML = `
        <div class="modal-header-grid">
          <div class="modal-icon-wrapper">
            <img src="${esc(safeUrl(entry.data.icon))}" alt="${esc(entry.data.title)} 的图标" class="modal-icon" />
          </div>
          <div class="modal-main-info">
            <h2 class="modal-title">${esc(entry.data.title)}</h2>
            <p class="modal-description">${esc(entry.data.description)}</p>
            <div class="modal-buttons">
              <a href="${esc(safeUrl(entry.data.href))}" target="_blank" rel="noopener noreferrer" class="modal-button primary">
                前往网站 >
              </a>
              <button class="modal-button" id="qr-code-btn">二维码访问</button>
            </div>
          </div>
        </div>
        <div class="modal-body">
          <h3>基本介绍</h3>
          ${renderedHTML}
        </div>
      `;
    } catch (err) {
      console.error('Error opening modal:', err);
      contentEl.innerHTML = '<div class="modal-loading">详情加载失败，请检查网络后重试。</div>';
    }
  });

  // 【2026-09-26】「详情」按钮改为事件委托：
  // NavCard 不再内联 onclick（严格 CSP 下会被拦截，且把 entryId 拼进 JS 字符串
  // 存在注入面），改为渲染 data-entry-id，由这里统一捕获后派发既有的 open-modal
  // 事件 —— 行为与改前完全一致（阻止 <a> 跳转 + 打开弹窗）。
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest?.('.detail-overlay[data-entry-id]') as HTMLElement | null;
    if (!btn) return;
    e.preventDefault();
    window.dispatchEvent(new CustomEvent('open-modal', { detail: { entryId: btn.dataset.entryId } }));
  });

  // 关闭相关：元素级绑定随每次导航重建；Esc 走 window 单次注册 + 动态查询当前弹窗
  function handleGlobalKeydown(e: KeyboardEvent) {
    if (e.key !== 'Escape') return;
    const backdrop = document.getElementById('modal-backdrop');
    if (backdrop && !backdrop.classList.contains('hidden')) backdrop.classList.add('hidden');
  }
  window.addEventListener('keydown', handleGlobalKeydown);

  // View Transitions：关闭按钮 / 遮罩点击绑定需在每次导航后重建（astro:page-load）
  function initCardModal() {
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close-btn');
    if (!backdrop || !closeBtn) return;
    const closeModal = () => backdrop.classList.add('hidden');
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) closeModal(); });
  }
  document.addEventListener('astro:page-load', initCardModal);
</script>

<!-- 
  【核心修复】
  这里的样式表现在变得非常干净，只包含作用于组件模板自身元素的规则。
-->
<style>
  .modal-backdrop {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-color: rgba(18, 18, 18, 0.5); display: flex;
    justify-content: center; align-items: center; z-index: 1000;
    opacity: 1; transition: opacity 0.25s ease;
  }
  .modal-backdrop.hidden { opacity: 0; pointer-events: none; }
  .modal-panel {
    background-color: white; border-radius: 12px; padding: 28px 32px;
    width: 90%; max-width: 700px; max-height: 85vh; overflow-y: auto;
    position: relative; transform: scale(1); transition: transform 0.25s ease;
  }
  .modal-backdrop.hidden .modal-panel { transform: scale(0.95); }
  .modal-close-btn {
    position: absolute; top: 12px; right: 12px; background: transparent;
    border: none; font-size: 2rem; cursor: pointer; color: #a0a0a0;
  }
  /* 详情加载中的占位提示（数据改为按需加载后新增） */
  .modal-loading {
    padding: 2.5rem 0;
    text-align: center;
    color: #999;
    font-size: 0.95rem;
  }

  /* marked 加载失败时的正文降级展示（纯文本，保证内容仍可读）。
     注意：该节点由 innerHTML 动态插入，**不带 astro scoped hash**，
     故必须用 :global 包裹，否则样式不生效。 */
  :global(.modal-body-fallback) {
    white-space: pre-wrap;
    word-break: break-word;
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #444;
    margin: 0;
  }

  /* ============================================================
     移动端覆盖（≤768px）【必须放本 scoped 块：关键修复】
     - 桌面 .modal-panel/.modal-close-btn 在此 scoped 定义 → 带
       [data-astro-cid] 特异性 (0,2,0)；modal.css 全局 media 里同
       名规则 (0,1,0) 特异性不足，永远压不过 → 移动端 max-height/
       padding/✕ 尺寸此前从未生效（五版都在改一个不生效的规则）。
     - 本块与桌面规则同 hash 同特异性、且同 style 内后声明 → 覆盖
       生效。其余 .modal-*（header/icon/title/buttons/body）桌面定义
       在 modal.css 全局，仍由 modal.css 的 media 负责，勿在此重复。
     ============================================================ */
  @media (max-width: 768px) {
    .modal-panel {
      width: 94%;
      padding: 14px 16px 16px;
      max-height: 75vh;              /* fallback：不支持 dvh 的旧浏览器 */
      max-height: 75dvh;             /* 面板最多占可视高 3/4，上下留白 */
      border-radius: 10px;
    }
    .modal-close-btn {
      top: 6px;
      right: 6px;
      font-size: 1.5rem;
    }
  }
</style>
