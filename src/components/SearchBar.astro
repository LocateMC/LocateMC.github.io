---
// src/components/SearchBar.astro

// 【双实例支持】uid 用于区分同页多实例（如：页眉实例 与 移动端下拉菜单实例），
// 各实例元素 id 加前缀互不冲突；不传 uid 时保持默认 id（兼容旧引用）。
const { uid = '' } = Astro.props;
const p = uid ? `${uid}-` : '';

// 【2026-09-04 暂时收敛为纯站内搜索】用户指示：取消导航页的「站外 / AI」搜索模式，
// 仅保留站内搜索，使搜索栏与资源页一致（单一胶囊输入框 + 放大镜，无模式切换）。
// 若要恢复站外搜索：加回 .search-tabs 三按钮（站内/站外/AI）与 #engine-select，
// 并在下方 script 恢复模式切换分支（原站外引擎数据：Google / Bing / MC Wiki）。
---
<div class="search-wrapper" data-uid={uid}>
  <div class="search-bar">
    <input type="search" id={`${p}search-input`} class="search-input" placeholder="搜索本站内容..." autocomplete="off" />
    <button id={`${p}search-button`} class="search-button" aria-label="搜索">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </button>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  let fuseInstance: Fuse<any> | null = null; // 模块级：懒加载的 Fuse 实例全局复用

  // 同一页可能存在多个搜索实例（页眉实例 uid='' + 移动端下拉菜单实例 uid='m'），
  // 且该 module 脚本在浏览器中仅执行一次：故统一遍历页面内全部 .search-wrapper 实例，
  // 每个实例绑定自己容器内的元素（避免跨实例交叉绑定）。
  // View Transitions 下每页 DOM 每次导航都是新实例：
  // 由 astro:page-load（初次加载 + 每次客户端导航）重建绑定。
  function initSearchBar() {
    document.querySelectorAll<HTMLElement>('.search-wrapper').forEach(root => {
      // 1. 初始化状态和DOM元素
      const uid = root.dataset.uid || '';
      const prefix = uid ? `${uid}-` : '';
      const searchInput = document.getElementById(`${prefix}search-input`) as HTMLInputElement | null;
      const searchButton = document.getElementById(`${prefix}search-button`);
      if (!searchInput || !searchButton) return;

      // 2. 异步初始化 Fuse.js
      async function initializeFuse() {
        if (fuseInstance) return; // 防止重复初始化
        try {
          const response = await fetch('/api/search-index.json');
          const searchData = await response.json();
          fuseInstance = new Fuse(searchData, {
            keys: ['title', 'description', 'href', 'tags'],
            threshold: 0.4, // 调整模糊搜索的敏感度
          });
        } catch (error) {
          console.error("Failed to initialize Fuse.js:", error);
        }
      }

      // 3. 执行站内搜索：仅由「点击搜索按钮 / 回车」显式触发，输入过程中不实时过滤
      //    （与资源页一致：导航页也收敛为纯站内搜索）
      async function performSearch() {
        const query = searchInput.value.trim();

        if (!fuseInstance) await initializeFuse(); // Fuse 索引尚未就绪则先加载
        if (!fuseInstance) return;

        // 如果搜索框为空，发送一个特殊信号来显示所有卡片
        if (!query) {
          window.dispatchEvent(new CustomEvent('search-results', { detail: { results: null } }));
          return;
        }

        const searchResults = fuseInstance.search(query);
        // 我们只提取匹配项的 ID
        const resultIds = searchResults.map(result => result.item.id);
        // 通过全局事件将结果 ID 发送给主页面
        window.dispatchEvent(new CustomEvent('search-results', { detail: { results: resultIds } }));
      }

      // 4. 事件绑定
      searchInput.addEventListener('focus', initializeFuse); // 聚焦输入框时预加载索引数据
      searchButton.addEventListener('click', () => performSearch());
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          performSearch();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initSearchBar);
</script>

<style>
  /* 
    搜索栏样式（页眉右侧插槽）
    整体为单一搜索胶囊（与资源页一致，纯站内搜索无模式标签），聚焦时高亮描边。
  */
  .search-wrapper {
    width: 300px; /* 与资源页 .header-search-float 一致（固定 300px） */
    margin: 0; /* 作为页眉右侧 flex 项，不居中 */
    flex-shrink: 1;
    min-width: 0;
  }

  .search-bar {
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 4px 0 16px;
    border: 1px solid #e3e3e3;
    border-radius: 22px;
    background-color: #f0f0f0;
    overflow: hidden;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* 聚焦时高亮：浅色描边 + 柔和光晕，提升质感 */
  .search-bar:focus-within {
    border-color: #1d9e75;
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(29, 158, 117, 0.12);
  }

  .search-input {
    flex-grow: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0 12px 0 0;
    font-size: 0.95rem;
    color: #333;
    font-family: 'HarmonyOS Sans', sans-serif;
    height: 100%;
  }
  .search-input:focus { outline: none; }
  .search-input::placeholder { color: #aaa; }

  .search-button {
    border: none;
    background: transparent;
    padding: 0 10px;
    cursor: pointer;
    color: #888;
    height: 100%;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .search-button:hover { color: #1d9e75; }
  .search-button:active { transform: scale(0.92); }

  /* 窄屏（移动端下拉菜单内的实例）：搜索胶囊占满可用宽度 */
  @media (max-width: 768px) {
    .search-wrapper {
      width: 100%;
      max-width: none;
    }
  }
</style>