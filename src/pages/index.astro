---
// src/pages/index.astro
import AppLayout from '../layouts/AppLayout.astro';
import NavCard from '../components/NavCard.astro'; 
import SearchBar from '../components/SearchBar.astro';
import Carousel from '../components/Carousel.astro';
import { getCollection } from 'astro:content';

interface NavCardData {
  id: string;
  title: string;
  description: string;
  icon: string;
  href: string;
}

interface CategoryData {
  id: string;
  name: string;
  children: CategoryData[];
  cards: NavCardData[];
}

// 从本地内容集合读取导航数据，按分类 / 子分类分组渲染
const allNavEntries = await getCollection('nav');
const sortedNavEntries = allNavEntries.sort((a, b) => a.data.order - b.data.order);

const toCard = (entry: (typeof allNavEntries)[number]): NavCardData => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  icon: entry.data.icon,
  href: entry.data.href,
});

const grouped: Record<string, {
  cards: (typeof allNavEntries)[number][];
  children: Record<string, (typeof allNavEntries)[number][]>;
}> = {};

for (const entry of sortedNavEntries) {
  const { category, subcategory } = entry.data;
  if (!grouped[category]) grouped[category] = { cards: [], children: {} };
  if (subcategory) {
    if (!grouped[category].children[subcategory]) grouped[category].children[subcategory] = [];
    grouped[category].children[subcategory].push(entry);
  } else {
    grouped[category].cards.push(entry);
  }
}

const categoryOrder = { '官方': 1, '社区': 2, '百科': 3, '资源': 4, '服务端': 5, '在线工具': 6, '软件程序': 7, '工作室 & 组织': 8, '开发': 9, '市场': 10, '收纳': 50 };
const sortedCategoryNames = Object.keys(grouped).sort((a, b) => {
  const orderA = categoryOrder[a] || 999;
  const orderB = categoryOrder[b] || 999;
  return orderA - orderB;
});
const subcategoryOrder = {
  '百科': { '百科': 1, '教程、文档': 2 },
  '资源': { '综合': 1, '地图、投影': 2, '模组、整合包': 3, '纹理、资源包、光影': 4 },
  '服务端': { '原版核心': 1, 'Bukkit·Paper系': 2, 'Folia系': 3, 'Mod服核心': 4, '混合端': 5, '代理端': 6, '基岩': 7, '互通': 8 },
  '软件程序': { '启动器': 1, '版本库': 2, '实用工具（PC）': 3, '实用工具（Android）': 4, '服务器面板': 5, },
  '开发': { 'Java 模组': 1, 'Java 光影': 2, 'Java 服务端': 3, '基岩': 4, '基岩 服务端': 5, },
  '在线工具': { '综合工具集': 1, '种子与地图': 2, '查询与素材库': 3, '皮肤与装扮': 4, '文字与排版': 5, '像素画与建筑': 6, '命令与数据包': 7, '资源包与定制': 8, '服务器与开发者': 9, },
  '市场': { '市场目录': 1, '合作伙伴': 2 },
};

const categories: CategoryData[] = sortedCategoryNames.map(categoryName => {
  const group = grouped[categoryName];
  const childNames = Object.keys(group.children).sort((a, b) => {
    const rules = subcategoryOrder[categoryName] || {};
    const orderA = rules[a] || 999;
    const orderB = rules[b] || 999;
    return orderA - orderB;
  });
  return {
    id: categoryName,
    name: categoryName,
    cards: group.cards.map(toCard),
    children: childNames.map(subName => ({
      id: `${categoryName}-${subName}`,
      name: subName,
      cards: group.children[subName].map(toCard),
      children: [],
    })),
  };
});
---

<AppLayout title="LocateMC - 导航">
  <!-- 搜索栏移入页眉右侧插槽（header-search），不再占据主内容区顶部 -->
  <SearchBar slot="header-search" />

  <!-- 卡片栏顶部的精选轮播栏 -->
  <Carousel />

  {categories.map(category => (
    <section id={category.name} class="category-section">
      <h2 class="category-title">{category.name}</h2>

      <!--
        视图模式 2 下的子分类 tab 栏（置于主分类标题下方，由 AppLayout 脚本填充按钮）；
        stacked 模式始终隐藏。
      -->
      {category.children && category.children.length > 0 && (
        <div class="subcategory-tabs" data-tabs-for={category.name} hidden></div>
      )}

      <!-- 渲染该分类下无子分类的卡片 -->
      {category.cards && category.cards.length > 0 && (
        <div class="nav-grid">
          {category.cards.map(card => (
            <div class="nav-card-wrapper" data-entry-id={card.id}>
              <NavCard 
                id={card.id} 
                title={card.title} 
                description={card.description} 
                icon={card.icon}
                href={card.href}
              />
            </div>
          ))}
        </div>
      )}

      <!-- 渲染子分类 -->
      {category.children && category.children.length > 0 && (
        category.children.map((childCategory, childIndex) => (
          <div
            id={`${category.name}-${childCategory.name}`}
            class="subcategory-block"
            data-category={category.name}
            data-subcategory={childCategory.name}
            data-active={childIndex === 0 ? 'true' : 'false'}
          >
            <h3 class="subcategory-title">{childCategory.name}</h3>
            <div class="nav-grid">
              {childCategory.cards.map(card => (
                <div class="nav-card-wrapper" data-entry-id={card.id}>
                  <NavCard
                    id={card.id}
                    title={card.title}
                    description={card.description}
                    icon={card.icon}
                    href={card.href}
                  />
                </div>
              ))}
            </div>
          </div>
        ))
      )}
    </section>
  ))}
</AppLayout>

<script>
  // ===== 站内搜索 × 视图模式（分组堆叠 / 子分类 Tab）的过滤协调 =====
  // 过滤只用 class（.search-hidden，见 AppLayout 全局样式）控制显隐，
  // 绝不写内联 display —— 内联样式会压过 Tab 折叠 CSS
  // （body[data-view-mode="tab"] .subcategory-block:not([data-active="true"]){display:none}），
  // 造成搜索后 Tab 视图失效、无法还原。
  let lastResults = null; // 最近一次搜索结果（null = 无搜索），供视图模式切换后重放
  let savedActive = null; // 搜索前各分类的激活子分类，清空搜索时还原

  /** 将某分类的 Tab 切换到指定子分类（复用 tab 按钮原生点击逻辑，保持 data-active 同步） */
  function activateTab(category, subcategory) {
    if (!category || !subcategory) return;
    const bar = [...document.querySelectorAll('.subcategory-tabs')]
      .find(b => b.dataset.tabsFor === category);
    if (!bar) return;
    const activeBlock = [...document.querySelectorAll('.subcategory-block')]
      .find(b => b.dataset.category === category && b.dataset.active === 'true');
    if (activeBlock && activeBlock.dataset.subcategory === subcategory) return; // 已在目标 tab
    const btn = [...bar.querySelectorAll('.subcategory-tab')]
      .find(t => t.dataset.target === subcategory);
    btn?.click();
  }

  function resetSearch() {
    document.querySelectorAll('.search-hidden').forEach(el => el.classList.remove('search-hidden'));
    document.querySelectorAll('.subcategory-tab').forEach(btn => { btn.disabled = false; });
    // 若搜索期间 Tab 被自动切换，清空后还原到搜索前的激活子分类
    if (savedActive && document.body.dataset.viewMode === 'tab') {
      savedActive.forEach((sub, cat) => activateTab(cat, sub));
    }
    savedActive = null;
    lastResults = null;
  }

  function applySearchFilter(results) {
    const allCards = [...document.querySelectorAll('.nav-card-wrapper')];
    const allSections = [...document.querySelectorAll('.category-section')];
    const allSubBlocks = [...document.querySelectorAll('.subcategory-block')];

    // Case 1: 搜索框被清空，显示所有内容（同时还原视图状态）
    if (results === null) { resetSearch(); return; }

    // 首次产生结果时，记录各分类当前激活的子分类（供清空搜索后还原）
    if (!savedActive) {
      savedActive = new Map();
      allSubBlocks.forEach(block => {
        if (block.dataset.active === 'true') {
          savedActive.set(block.dataset.category, block.dataset.subcategory);
        }
      });
    }

    const resultSet = new Set(results);

    // 1) 卡片过滤：命中保留，未命中隐藏
    allCards.forEach(card => {
      card.classList.toggle('search-hidden', !resultSet.has(card.dataset.entryId));
    });

    // 2) 子分类块过滤：含命中卡片的块保留，统计各分类命中块（DOM 顺序即展示顺序）
    const hitByCat = new Map();
    allSubBlocks.forEach(block => {
      const hasHit = [...block.querySelectorAll('.nav-card-wrapper')]
        .some(c => !c.classList.contains('search-hidden'));
      block.classList.toggle('search-hidden', !hasHit);
      if (hasHit) {
        const cat = block.dataset.category;
        if (!hitByCat.has(cat)) hitByCat.set(cat, []);
        hitByCat.get(cat).push(block);
      }
    });

    // 3) 主分类显隐：分类内任一可见卡片即显示
    allSections.forEach(section => {
      const anyVisible = [...section.querySelectorAll('.nav-card-wrapper')]
        .some(c => !c.classList.contains('search-hidden'));
      section.classList.toggle('search-hidden', !anyVisible);
    });

    // 4) Tab 模式「跟随 Tab」：当前激活子分类无命中时，自动切到第一个含命中的子分类
    if (document.body.dataset.viewMode === 'tab') {
      const byCat = new Map();
      allSubBlocks.forEach(b => {
        if (!byCat.has(b.dataset.category)) byCat.set(b.dataset.category, []);
        byCat.get(b.dataset.category).push(b);
      });
      byCat.forEach((blocks, cat) => {
        const hitBlocks = hitByCat.get(cat) || [];
        if (!hitBlocks.length) return; // 该分类无命中，整节将由第 3 步隐藏
        const active = blocks.find(b => b.dataset.active === 'true');
        if (!active || active.classList.contains('search-hidden')) {
          activateTab(cat, hitBlocks[0].dataset.subcategory);
        }
      });
    }

    // 5) Tab 按钮联动：无命中的子分类 tab 置灰（disabled 原生阻止点击）
    document.querySelectorAll('.subcategory-tab').forEach(btn => {
      const cat = btn.closest('.subcategory-tabs')?.dataset.tabsFor;
      const hitSubs = (hitByCat.get(cat) || []).map(b => b.dataset.subcategory);
      btn.disabled = !hitSubs.includes(btn.dataset.target);
    });
  }

  // 站内搜索事件（SearchBar 派发）
  window.addEventListener('search-results', (event) => {
    lastResults = event.detail.results;
    applySearchFilter(event.detail.results);
  });

  // 视图模式切换后重放当前搜索过滤（避免切到 Tab 后停留在无命中的子分类）
  window.addEventListener('view-mode-changed', () => {
    if (lastResults !== null) applySearchFilter(lastResults);
  });
</script>

<style>
  .category-section { 
    margin-bottom: 3rem; 
    scroll-margin-top: 80px; 
  }
  .category-title { 
    font-size: 1.8rem; 
    color: #333; 
    margin-bottom: 1.5rem; 
    font-weight: 600; 
  }
  .subcategory-block { 
    margin-bottom: 2.5rem; 
    scroll-margin-top: 80px;
  }
  .subcategory-title { 
    font-size: 1.2rem; 
    color: #555; 
    margin-bottom: 1rem; 
    font-weight: 500; 
  }
  
  .nav-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    transition: grid-template-columns 0.3s ease;
  }
</style>
