    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
    font-family: inherit;
    flex-shrink: 0;
  }
  .fp-close:hover { background: #e5e7eb; color: #111; }

  /* 移动端抽屉底部的「查看结果」按钮（点击后收起抽屉看筛选结果） */
  .fp-done {
    display: none; /* 桌面（侧栏常驻）不需要 */
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.55rem 0.75rem;
    background: #1d4ed8;
    color: #ffffff;
    border: 0;
    border-radius: 8px;
