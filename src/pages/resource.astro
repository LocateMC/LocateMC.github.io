    width: 100%;
    padding: 0.5rem 2rem 0.5rem 0.75rem;
    background: #f5f7fa url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none'><path d='M6 9l6 6 6-6' stroke='%236b7280' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/></svg>") no-repeat right 0.75rem center;
    border: 1px solid #e7e9ee;
    border-radius: 10px;
    font-size: 0.9rem;
    color: #111;
