  /* 筛选过滤用的 hidden class（与 index.astro 保持一致，全局生效） */
  :global(.search-hidden) { display: none !important; }

  /* ===== 资源页移动端（≤768px）=====
     必须放在 scoped <style> 末尾（不能放 is:global）：本段要覆盖的
     .resource-library / .filter-toggle / .resource-grid / .resource-title 等
     桌面默认值都定义在 scoped 里（带 data-astro-cid，特异性 (0,2,0)），
     is:global 的 (0,1,0) 规则永远压不过它们 —— 实证：第一版修复把段放
     is:global，「筛选」按钮仍被 display:none 压死，用户反馈"疑似未修复"。
     放在本块内则 Astro 自动加 hash，与桌面规则同特异性、后声明生效。
     body[data-resource-filter-open] 前缀会自动保留（参照 AppLayout 先例）。 */
  @media (max-width: 768px) {
    /* 主区改为单列：filter-panel 移出文档流改做抽屉 */
    .resource-library { display: block; padding: 0; }

    /* 抽屉容器：默认左滑出屏外，打开后滑入 */
    .filter-panel {
      position: fixed;
      top: 56px;
      left: 0;
      width: 86vw;
      max-width: 360px;
      height: calc(100vh - 56px);
      /* 覆盖 is:global 桌面的 max-height:calc(100vh - 116px)（旧版为 sticky 侧栏预留） */
      max-height: calc(100vh - 56px);
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      z-index: 200;
      background: #ffffff;
      box-shadow: 4px 0 18px rgba(0, 0, 0, 0.12);
      border-right: 1px solid #e5e5e5;
      /* 右缘上下圆角：左缘贴屏幕边缘保持直角，右缘柔化（用户要求） */
      border-radius: 0 16px 16px 0;
      overflow-y: auto;
    }
    body[data-resource-filter-open] .filter-panel { transform: translateX(0); }

    /* 遮罩（.filter-backdrop 桌面 display:none 在 scoped，此处同块后置覆盖） */
    body[data-resource-filter-open] .filter-backdrop {
      display: block;
      position: fixed;
      top: 56px; left: 0; right: 0; bottom: 0;
      background: rgba(15, 20, 30, 0.35);
      z-index: 199;
    }

    /* 「筛选」入口：固定于页眉右上角（height 与页眉同高 56px → 视觉垂直居中于页面右上角）。
