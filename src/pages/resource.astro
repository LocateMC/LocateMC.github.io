    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(29, 158, 117, 0.12);
  }
  .fp-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    padding: 0 12px 0 0;
    font-size: 0.95rem;
    color: #333;
    font-family: 'HarmonyOS Sans', sans-serif;
    height: 100%;
  }
  .fp-search input:focus { outline: none; }
  .fp-search input::placeholder { color: #aaa; }
  .fp-search input::-webkit-search-cancel-button { cursor: pointer; }
  .fp-search-btn {
    border: none;
    background: transparent;
    padding: 0 10px;
    cursor: pointer;
    color: #888;
    height: 100%;
    display: flex;
    align-items: center;
