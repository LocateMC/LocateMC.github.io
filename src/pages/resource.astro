  }
  .fp-option:hover { background: #f3f4f6; }
  .fp-option input { accent-color: #1d4ed8; cursor: pointer; margin: 0; flex-shrink: 0; }
  .fp-option-label { font-weight: 500; }
  .fp-hint {
    padding: 0.35rem 0.5rem;
    font-size: 0.8rem;
    color: #9ca3af;
  }
  .fp-footer { padding: 0.5rem; border-top: 1px solid #f0f1f4; }
  .fp-reset {
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 1px solid #e7e9ee;
    border-radius: 8px;
    color: #4b5563;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
    font-family: inherit;
  }
  .fp-reset:hover { background: #f3f4f6; color: #111; }

  /* ===== 移动端抽屉的动态节点（≤768px）=====
     注意：抽屉内 .fp-drawer-head / .fp-done / .mobile-only 由 JS innerHTML 渲染、
     不带 scoped hash —— 放在 scoped <style> 会因选择器加了 [data-astro-cid] 而失配，
     必须在本全局块里覆盖（默认 display:none 亦在此文件全局区定义）。 */
  @media (max-width: 768px) {
    .fp-drawer-head { display: flex; }
    .fp-done { display: block; }
    .mobile-only { display: block; }
  }
</style>