    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  details.fp-block[open] .fp-block-header .fp-caret { transform: rotate(45deg); }
  .fp-select-row { position: relative; padding: 0 0.5rem; }
  .fp-native-select {
    appearance: none;
